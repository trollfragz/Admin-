rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTester() {
      return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }
    function okText(v, n) { return v is string && v.size() <= n; }
    function validHead(d) {
      return !('headData' in d) || (d.headData is string && d.headData.size() < 2000
        && d.headData.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$'));
    }

    // You create these by hand in the console: roles/{uid} with field role = "tester"
    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Public player profiles. Only testers (the admin page) can create or change them.
    match /users/{id} {
      allow read: if true;
      allow create, update: if isTester()
        && request.resource.data.keys().hasOnly(['ign','region','youtube','discordLink','description','headData','createdAt'])
        && request.resource.data.keys().hasAll(['ign','createdAt'])
        && request.resource.data.ign is string
        && request.resource.data.ign.matches('^[A-Za-z0-9_ ]{3,16}$')
        && (!('region' in request.resource.data) || request.resource.data.region in ['','NA','EU','AS','SA','OC','AF'])
        && (!('youtube' in request.resource.data) || okText(request.resource.data.youtube, 200))
        && (!('discordLink' in request.resource.data) || okText(request.resource.data.discordLink, 200))
        && (!('description' in request.resource.data) || okText(request.resource.data.description, 300))
        && validHead(request.resource.data);
      allow delete: if isTester();
    }

    // Private notes (the player's Discord username). Only testers can read or write.
    match /private/{id} {
      allow read: if isTester();
      allow create, update: if isTester()
        && request.resource.data.keys().hasOnly(['discord','serverLink'])
        && (!('discord' in request.resource.data) || okText(request.resource.data.discord, 40))
        && (!('serverLink' in request.resource.data) || okText(request.resource.data.serverLink, 200));
      allow delete: if isTester();
    }

    // Tiers of every player
    match /players/{id} {
      allow read: if true;
      allow write: if isTester();
    }

    // Full skin (base64 PNG), loaded only on a player's page
    match /skins/{id} {
      allow read: if true;
      allow create, update: if isTester()
        && request.resource.data.keys().hasOnly(['data','updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 50000
        && request.resource.data.data.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$');
      allow delete: if isTester();
    }

    // Reserves a username so two players never share one
    match /names/{n} {
      allow read: if true;
      allow create: if isTester() && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if isTester();
    }

    // Ready-made cards (JPEG as base64 text): cards/{playerId} and cards/lb-overall, cards/lb-boxing ...
    match /cards/{id} {
      allow read: if true;
      allow create, update: if isTester()
        && request.resource.data.keys().hasOnly(['data','bg','updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.data[0:23] == 'data:image/jpeg;base64,';
      allow delete: if isTester();
    }

    // Look of the website (colours, sizes, text, box order), one document per device
    match /siteConfig/{id} {
      allow read: if true;
      allow create, update: if isTester() && id in ['desktop','mobile'];
    }
  }
}
